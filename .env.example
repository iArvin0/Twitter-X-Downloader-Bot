BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

DOWNLOAD_DIR=downloads
LOG_DIR=logs
LOG_LEVEL=INFO

# General Telegram upload limit used by this bot.
MAX_FILE_SIZE_MB=49

# Photos at or below this size are attempted with sendPhoto.
# Larger images (but still under MAX_FILE_SIZE_MB) are sent as documents.
MAX_PHOTO_SIZE_MB=10

MAX_CONCURRENT_DOWNLOADS=2
MAX_MEDIA_PER_POST=4
DOWNLOAD_TIMEOUT_SECONDS=300

# Optional Netscape-format cookies.txt for content your own X account
# is authorized to view. Used by both yt-dlp and gallery-dl.
# Never commit this file to GitHub.
YTDLP_COOKIES_FILE=
